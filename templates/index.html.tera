<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>vxfemboy</title>
    <link rel="icon" type="image/png" href="/static/favicon.png">
    <link rel="stylesheet" href="/static/css/main.css">
    <div id="stars-container">
        {% for star in stars %}
            <div class="star" style="left: {{ star.x }}%; top: {{ star.y }}%; animation-delay: {{ star.delay }}s; transform: scale({{ star.size }});">{{ star.char }}</div>
        {% endfor %}
    </div>
    <div class="ascii-container">
        <div class="ascii-title">
            <pre>{{ title_art | safe }}</pre>
        </div>

        <div class="ascii-nav">
            <div class="box-tiny"><pre>{{ navigation_box.tiny | safe }}</pre></div>
            <div class="box-small"><pre>{{ navigation_box.small | safe }}</pre></div>
            <div class="box-medium"><pre>{{ navigation_box.medium | safe }}</pre></div>
            <div class="box-large"><pre>{{ navigation_box.large | safe }}</pre></div>
        </div>

        <div class="main-content-wrapper">
            <div class="ascii-content">
                <div class="ascii-box welcome-box">
                    <div class="box-tiny"><pre>{{ welcome_box.tiny | safe }}</pre></div>
                    <div class="box-small"><pre>{{ welcome_box.small | safe }}</pre></div>
                    <div class="box-medium"><pre>{{ welcome_box.medium | safe }}</pre></div>
                    <div class="box-large"><pre>{{ welcome_box.large | safe }}</pre></div>
                </div>

                <div class="ascii-box latest-posts-box">
                    <div class="box-tiny"><pre>{{ latest_post_box.tiny | safe }}</pre></div>
                    <div class="box-small"><pre>{{ latest_post_box.small | safe }}</pre></div>
                    <div class="box-medium"><pre>{{ latest_post_box.medium | safe }}</pre></div>
                    <div class="box-large"><pre>{{ latest_post_box.large | safe }}</pre></div>
                </div>

                <!-- Additional posts for mobile dropdown -->
                <div id="additional-posts-mobile" style="display:none;">
                    {% for post in additional_posts %}
                    <div class="ascii-box">
                        <div class="box-small">
                            <pre>░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░

{{ post.title }}
{{ post.date }}

{{ post.content }}

Read more: <a href="{{ post.href }}">{{ post.title }}</a>

░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░</pre>
                        </div>
                    </div>
                    {% endfor %}
                </div>

            </div>

            <div class="ascii-sidebar">
                <div class="ascii-box">
                    <div class="box-tiny"><pre>{{ about_box.tiny | safe }}</pre></div>
                    <div class="box-small"><pre>{{ about_box.small | safe }}</pre></div>
                    <div class="box-medium"><pre>{{ about_box.medium | safe }}</pre></div>
                    <div class="box-large"><pre>{{ about_box.large | safe }}</pre></div>
                </div>

                <div class="ascii-box">
                    <div class="box-tiny"><pre>{{ categories_box.tiny | safe }}</pre></div>
                    <div class="box-small"><pre>{{ categories_box.small | safe }}</pre></div>
                    <div class="box-medium"><pre>{{ categories_box.medium | safe }}</pre></div>
                    <div class="box-large"><pre>{{ categories_box.large | safe }}</pre></div>
                </div>

                <div class="ascii-box" id="shoutbox-container">
                    <div class="box-tiny">
                        <pre id="shoutbox-tiny">{{ comments_box.tiny | safe }}</pre>
                        <div class="shoutbox-input-container">
                            <input type="text" id="shoutbox-input-tiny" placeholder="username: message" maxlength="50">
                        </div>
                    </div>
                    <div class="box-small">
                        <pre id="shoutbox-small">{{ comments_box.small | safe }}</pre>
                        <div class="shoutbox-input-container">
                            <input type="text" id="shoutbox-input-small" placeholder="username: message" maxlength="50">
                        </div>
                    </div>
                    <div class="box-medium">
                        <pre id="shoutbox-medium">{{ comments_box.medium | safe }}</pre>
                        <div class="shoutbox-input-container">
                            <input type="text" id="shoutbox-input-medium" placeholder="username: message" maxlength="50">
                        </div>
                    </div>
                    <div class="box-large">
                        <pre id="shoutbox-large">{{ comments_box.large | safe }}</pre>
                        <div class="shoutbox-input-container">
                            <input type="text" id="shoutbox-input-large" placeholder="username: message" maxlength="50">
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="ascii-footer">
            <div class="box-tiny"><pre>{{ footer_box.tiny | safe }}</pre></div>
            <div class="box-small"><pre>{{ footer_box.small | safe }}</pre></div>
            <div class="box-medium"><pre>{{ footer_box.medium | safe }}</pre></div>
            <div class="box-large"><pre>{{ footer_box.large | safe }}</pre></div>
        </div>
    </div>

    <script type="module">
        // Load WASM module and initialize ASCII cat
        import init, { AsciiCat } from '/static/wasm/ascii_web.js';

            async function run() {
                try {
                    console.log('Starting ASCII cat initialization...');

                    // Initialize WASM
                    await init();
                    console.log('WASM initialized');
                
                    // Preload all cat animations
                    console.log('Preloading cat animations...');
                    const animations = {};
                    const animationNames = [
                        'still', 'alert', 'yawn', 'sleep1', 'sleep2',
                        'nrun1', 'nrun2', 'nerun1', 'nerun2',
                        'erun1', 'erun2', 'serun1', 'serun2',
                        'srun1', 'srun2', 'swrun1', 'swrun2',
                        'wrun1', 'wrun2', 'nwrun1', 'nwrun2',
                        'nscratch1', 'nscratch2', 'escratch1', 'escratch2',
                        'sscratch1', 'sscratch2', 'wscratch1', 'wscratch2',
                        'wash', 'itch1', 'itch2'
                    ];
                    
                    for (const name of animationNames) {
                        try {
                            console.log(`Fetching animation: /cat/${name}`);
                            const response = await fetch(`/cat/${name}`);
                            console.log(`Response status for ${name}:`, response.status);
                            
                            if (!response.ok) {
                                throw new Error(`HTTP ${response.status}: ${response.statusText}`);
                            }
                            
                            const content = await response.text();
                            animations[name] = content;
                            console.log(`Loaded animation: ${name} (${content.length} chars)`);
                        } catch (error) {
                            console.error(`Failed to load animation ${name}:`, error);
                        }
                    }
                    
                    console.log('All animations preloaded');
                    console.log('Animation keys:', Object.keys(animations));
                    console.log('Sample animation (still):', animations.still ? 'loaded' : 'missing');
                
                    // Create ASCII cat instance with animations
                    const cat = new AsciiCat(animations);
                    console.log('ASCII cat instance created');
                    try { cat.init_shoutbox(); } catch (e) { console.warn('WASM shoutbox init failed', e); }
                
                // Track mouse movement (oneko.js style)
                document.addEventListener('mousemove', (e) => {
                    cat.update_mouse(e.clientX, e.clientY);
                });
                console.log('Mouse listener added');
                
                // Animation loop (ultra smooth - 30ms intervals for very fluid motion ~33fps)
                let lastFrameTimestamp;
                function onAnimationFrame(timestamp) {
                    if (!lastFrameTimestamp) {
                        lastFrameTimestamp = timestamp;
                    }
                    if (timestamp - lastFrameTimestamp > 30) {  // 30ms = ~33fps for ultra smooth animation
                        lastFrameTimestamp = timestamp;
                        cat.update();
                    }
                    requestAnimationFrame(onAnimationFrame);
                }
                requestAnimationFrame(onAnimationFrame);
                console.log('Animation loop started (ultra smooth ~33fps)');
                
                console.log('ASCII cat is now following your cursor!');
            } catch (error) {
                console.error('Error initializing ASCII cat:', error);
            }
        }

        run();
    </script>

    <!-- Floating (draggable) Shoutbox -->
    <div id="shoutbox-float">
        <div class="shoutbox-float-content" style="position: relative;">
            <pre id="shoutbox-modal-pre"></pre>
            <div class="shoutbox-input-container">
                <input type="text" id="shoutbox-input-modal" placeholder="username: message" maxlength="120">
            </div>
            <!-- Click overlay for [x] icon inside expanded title bar -->
            <button id="sb-collapse-btn" class="sb-icon-hit" type="button" title="Collapse shoutbox" style="right: 6px; top: 18px; width: 40px; height: 18px; background: transparent; border: 0; padding: 0; z-index: 1;"></button>
        </div>
    </div>

    <script>
        // Realtime Shoutbox WebSocket functionality
        class ShoutboxManager {
            constructor() {
                this.ws = null;
                this.isConnected = false;
                this.messages = [];
                this.maxMessagesCount = 50;
                this.maxLines = 5;
                this.connectedUsers = 0;
                this.isExpanded = false;
                this.init();
            }

            init() {
                this.connectWebSocket();
                this.setupInputHandling();
                this.loadInitialMessages();
            }

            connectWebSocket() {
                const protocol = window.location.protocol === 'https:' ? 'wss:' : 'ws:';
                const wsUrl = `${protocol}//${window.location.host}/ws/shoutbox`;
                
                try {
                    this.ws = new WebSocket(wsUrl);
                    
                    this.ws.onopen = () => {
                        console.log('Shoutbox WebSocket connected');
                        this.isConnected = true;
                        this.updateConnectionStatus('Connected');
                        this.requestMessages();
                    };

                    this.ws.onmessage = (event) => {
                        try {
                            const data = JSON.parse(event.data);
                            this.handleMessage(data);
                        } catch (error) {
                            console.error('Error parsing WebSocket message:', error);
                        }
                    };

                    this.ws.onclose = () => {
                        console.log('Shoutbox WebSocket disconnected');
                        this.isConnected = false;
                        this.updateConnectionStatus('Disconnected');
                        // Attempt to reconnect after 3 seconds
                        setTimeout(() => this.connectWebSocket(), 3000);
                    };

                    this.ws.onerror = (error) => {
                        console.error('WebSocket error:', error);
                        this.updateConnectionStatus('Error');
                    };
                } catch (error) {
                    console.error('Failed to create WebSocket connection:', error);
                }
            }

            handleMessage(data) {
                console.log('Received WebSocket message:', data);
                switch (data.action) {
                    case 'new_message':
                        if (data.message) {
                            console.log('Adding new message:', data.message);
                            this.addMessage(data.message);
                        }
                        break;
                    case 'messages':
                        if (data.messages) {
                            console.log('Received messages:', data.messages);
                            this.messages = data.messages.slice(-this.maxMessagesCount);
                            this.renderMessages();
                        }
                        break;
                    case 'user_count':
                        if (data.user_count !== undefined) {
                            this.connectedUsers = data.user_count;
                            this.renderMessages();
                        }
                        break;
                    case 'error':
                        console.error('Shoutbox error:', data.error);
                        break;
                    default:
                        console.log('Unknown message action:', data.action);
                        break;
                }
            }

            requestMessages() {
                if (this.isConnected) {
                    this.ws.send(JSON.stringify({ action: 'get_messages' }));
                }
            }

            sendMessage(username, content) {
                if (this.isConnected && username.trim() && content.trim()) {
                    this.ws.send(JSON.stringify({
                        action: 'send_message',
                        username: username.trim(),
                        content: content.trim()
                    }));
                }
            }

            addMessage(message) {
                console.log('Adding message to local array:', message);
                this.messages.push(message);
                if (this.messages.length > this.maxMessages) {
                    this.messages.shift();
                }
                console.log('Current messages:', this.messages);
                this.renderMessages();
            }

            renderMessages() {
                console.log('Rendering messages, current count:', this.messages.length);
                // Sort messages by timestamp to show newest at bottom (oldest first)
                const sortedMessages = this.messages.sort((a, b) => new Date(a.timestamp) - new Date(b.timestamp));
                const messages = sortedMessages.slice(-this.maxMessages);
                console.log('Messages to render:', messages);
                
                // Get the appropriate width based on screen size
                const getMaxWidth = () => {
                    if (window.innerWidth <= 400) return 21; // COMMENTS_WIDTH_TINY - 2 for borders
                    if (window.innerWidth <= 600) return 26; // COMMENTS_WIDTH_SMALL - 2 for borders  
                    if (window.innerWidth <= 900) return 41; // COMMENTS_WIDTH_MEDIUM - 2 for borders
                    return 53; // COMMENTS_WIDTH_LARGE - 2 for borders
                };
                
                const maxWidth = Math.max(20, getMaxWidth()); // Ensure minimum width
                
                // Helper function to wrap text to fit within box width
                function wrapText(text, maxWidth, allowHardWrap) {
                    if (text.length <= maxWidth) {
                        return [text];
                    }
                    const words = text.split(' ');
                    const lines = [];
                    let currentLine = '';
                    
                    for (const word of words) {
                        if ((currentLine + (currentLine ? ' ' : '') + word).length <= maxWidth) {
                            currentLine += (currentLine ? ' ' : '') + word;
                        } else {
                            if (currentLine) {
                                lines.push(currentLine);
                                currentLine = '';
                            }
                            // If the word itself is longer than maxWidth
                            if (word.length > maxWidth) {
                                if (allowHardWrap) {
                                    // Break the long word into chunks with no truncation
                                    for (let i = 0; i < word.length; i += maxWidth) {
                                        lines.push(word.substring(i, i + maxWidth));
                                    }
                                } else {
                                    lines.push(word.substring(0, maxWidth - 3) + '...');
                                }
                            } else {
                                currentLine = word;
                            }
                        }
                    }
                    if (currentLine) {
                        lines.push(currentLine);
                    }
                    return lines;
                }

                // Format messages to fit in the box
                let messageLines = [];
                if (messages.length > 0) {
                    messages.forEach(msg => {
                        const username = msg.username.length > 10 ? msg.username.substring(0, 10) : msg.username;
                        const messageText = `@${username}: "${msg.content}"`;
                        const wrapped = wrapText(messageText, maxWidth, this.isExpanded);
                        messageLines.push(...wrapped);
                    });
                } else {
                    messageLines = ['No messages yet. Be the first to shout!'];
                }

                // Keep the most recent lines visible
                messageLines = messageLines.slice(-this.maxLines);

                // Pad lines to exact width
                const paddedLines = messageLines.map(line => {
                    if (line.length > maxWidth) {
                        return line.substring(0, maxWidth - 3) + '...';
                    }
                    return line.padEnd(maxWidth);
                });

                const statusText = `${this.isConnected ? 'Connected' : 'Disconnected'} - ${this.connectedUsers} users`;
                const paddedStatus = statusText.length > maxWidth ? 
                    statusText.substring(0, maxWidth - 3) + '...' : 
                    statusText.padEnd(maxWidth);

                // Create responsive shoutbox content for each screen size
                const createShoutboxContent = (width, visibleLines) => {
                    // Ensure width is positive and reasonable
                    const safeWidth = Math.max(20, width);
                    
                    const borderTop = '╔' + '═'.repeat(safeWidth) + '╗';
                    const borderBottom = '╚' + '═'.repeat(safeWidth) + '╝';
                    const borderLine = '╠' + '═'.repeat(safeWidth) + '╣';
                    const emptyLine = '║' + ' '.repeat(safeWidth) + '║';
                    
                    const title = 'SHOUTBOX';
                    const iconStr = this.isExpanded ? '[x]' : '[+]'; // ASCII-safe icons
                    const reserved = iconStr.length + 1; // space + icon at far right
                    const paddingSpace = Math.max(0, Math.floor((safeWidth - title.length - reserved) / 2));
                    const rightSpace = Math.max(0, safeWidth - title.length - reserved - paddingSpace);
                    const titleContent = ' '.repeat(paddingSpace) + title + ' '.repeat(rightSpace) + ' ' + iconStr;
                    const titleLine = '║' + titleContent + '║';
                    
                    const statusLine = '║ ' + paddedStatus.substring(0, Math.max(0, safeWidth - 3)).padEnd(Math.max(0, safeWidth - 3)) + '  ║';
                    
                    let content = borderTop + '\n' + titleLine + '\n' + borderLine + '\n' + emptyLine + '\n' + statusLine + '\n' + emptyLine + '\n';
                    
                    // Add message lines
                    paddedLines.forEach(line => {
                        const paddedLine = line.substring(0, Math.max(0, safeWidth - 3)).padEnd(Math.max(0, safeWidth - 3));
                        content += '║ ' + paddedLine + '  ║\n';
                    });
                    
                    // Add remaining empty lines to reach target visible lines
                    const remainingLines = Math.max(0, visibleLines - paddedLines.length);
                    for (let i = 0; i < remainingLines; i++) {
                        content += emptyLine + '\n';
                    }
                    
                    content += emptyLine + '\n';
                    content += borderBottom;
                    
                    return content;
                };

                // Update all responsive versions with correct widths
                const tinyPre = document.getElementById('shoutbox-tiny');
                const smallPre = document.getElementById('shoutbox-small');
                const medPre = document.getElementById('shoutbox-medium');
                const largePre = document.getElementById('shoutbox-large');
                const fill = (pre, width) => {
                    if (!pre) return;
                    pre.textContent = createShoutboxContent(width, this.maxLines);
                    pre.dataset.sbWidth = String(width);
                    // Insert an absolutely-positioned transparent button over the icon region for reliable clicks
                    pre.style.position = 'relative';
                    // Remove existing overlay if any
                    const old = pre.querySelector('.sb-icon-hit');
                    if (old) old.remove();
                    const btn = document.createElement('button');
                    btn.type = 'button';
                    btn.className = 'sb-icon-hit';
                    btn.style.background = 'transparent';
                    btn.style.border = '0';
                    btn.style.padding = '0';
                    btn.style.width = '40px';
                    btn.style.height = '18px';
                    btn.style.right = '6px';
                    btn.style.top = '18px'; // title row (accounting for top border)
                    btn.style.position = 'absolute';
                    btn.title = 'Expand shoutbox';
                    btn.addEventListener('click', (e) => { e.stopPropagation(); this.toggleExpand(true); });
                    pre.appendChild(btn);
                };
                fill(tinyPre, 25);
                fill(smallPre, 30);
                fill(medPre, 45);
                fill(largePre, 55);

                // Update expanded modal if open
                const modal = document.getElementById('shoutbox-float');
                if (modal && modal.style.display === 'block') {
                    const modalPre = document.getElementById('shoutbox-modal-pre');
                    // Measure actual monospace char width to size exactly to viewport
                    const measure = document.createElement('span');
                    measure.style.visibility = 'hidden';
                    measure.style.position = 'absolute';
                    measure.style.whiteSpace = 'pre';
                    measure.style.fontFamily = 'Departure Mono, Courier New, monospace';
                    measure.textContent = 'X';
                    document.body.appendChild(measure);
                    const ch = Math.max(1, measure.getBoundingClientRect().width);
                    measure.remove();

                    const sidePadding = 20; // container padding and border approx
                    const viewportPx = Math.floor(window.innerWidth * 0.94) - sidePadding;
                    let estimatedChars = Math.floor(viewportPx / ch);
                    const isMobile = window.innerWidth <= 600;
                    // Clamp based on device to avoid oversizing
                    estimatedChars = Math.max(24, Math.min(isMobile ? 60 : 120, estimatedChars));
                    modalPre.textContent = createShoutboxContent(estimatedChars, this.maxLines);
                }
            }

            updateConnectionStatus(status) {
                // This will be reflected in the next renderMessages call
                console.log(`Shoutbox status: ${status}`);
            }

            setupInputHandling() {
                // Setup input field handlers
                const inputIds = ['shoutbox-input-tiny', 'shoutbox-input-small', 'shoutbox-input-medium', 'shoutbox-input-large', 'shoutbox-input-modal'];
                
                inputIds.forEach(inputId => {
                    const input = document.getElementById(inputId);
                    if (input) {
                        input.addEventListener('keypress', (e) => {
                            if (e.key === 'Enter') {
                                const value = input.value.trim();
                                if (value) {
                                    // Parse username and message from "username: message" format
                                    const colonIndex = value.indexOf(':');
                                    if (colonIndex > 0) {
                                        const username = value.substring(0, colonIndex).trim();
                                        const message = value.substring(colonIndex + 1).trim();
                                        if (username && message) {
                                            this.sendMessage(username, message);
                                            input.value = ''; // Clear input
                                        }
                                    } else {
                                        // If no colon, treat as message with default username
                                        this.sendMessage('anon', value);
                                        input.value = ''; // Clear input
                                    }
                                }
                            }
                        });
                    }
                });

                const expandBtn = document.getElementById('shoutbox-expand-btn');
                const closeBtn = document.getElementById('shoutbox-close-btn');
                const collapseBtn = document.getElementById('sb-collapse-btn');
                if (collapseBtn) {
                    collapseBtn.addEventListener('click', (e) => { e.stopPropagation(); this.toggleExpand(false); });
                }
                // Drag handling
                const float = document.getElementById('shoutbox-float');
                const handle = document.querySelector('#shoutbox-float .shoutbox-float-content');
                let dragging = false, offsetX = 0, offsetY = 0;
                const enableDrag = () => window.innerWidth > 600; // disable on mobile
                if (handle && float && enableDrag()) {
                    handle.addEventListener('mousedown', (e) => {
                        dragging = true;
                        const rect = float.getBoundingClientRect();
                        offsetX = e.clientX - rect.left;
                        offsetY = e.clientY - rect.top;
                    });
                    window.addEventListener('mousemove', (e) => {
                        if (!dragging) return;
                        float.style.left = `${e.clientX - offsetX}px`;
                        float.style.top = `${e.clientY - offsetY}px`;
                        float.style.transform = 'none';
                    });
                    window.addEventListener('mouseup', () => dragging = false);
                    // Touch support (only non-mobile tablets)
                    handle.addEventListener('touchstart', (e) => {
                        if (!enableDrag()) return;
                        const t = e.touches[0];
                        dragging = true;
                        const rect = float.getBoundingClientRect();
                        offsetX = t.clientX - rect.left;
                        offsetY = t.clientY - rect.top;
                    }, { passive: true });
                    window.addEventListener('touchmove', (e) => {
                        if (!dragging || !enableDrag()) return;
                        const t = e.touches[0];
                        float.style.left = `${t.clientX - offsetX}px`;
                        float.style.top = `${t.clientY - offsetY}px`;
                        float.style.transform = 'none';
                    }, { passive: true });
                    window.addEventListener('touchend', () => dragging = false);
                }

                // Click-to-expand icon inside title bar
                const attachIconClick = (preEl) => {
                    if (!preEl) return;
                    preEl.addEventListener('click', (e) => {
                        if (this.isExpanded) return; // handled by modal
                        const rect = preEl.getBoundingClientRect();
                        const style = window.getComputedStyle(preEl);
                        const lineH = parseFloat(style.lineHeight) || 16;
                        const tester = document.createElement('span');
                        tester.style.visibility = 'hidden';
                        tester.style.position = 'absolute';
                        tester.style.whiteSpace = 'pre';
                        tester.style.fontFamily = style.fontFamily;
                        tester.textContent = 'X';
                        document.body.appendChild(tester);
                        const ch = Math.max(1, tester.getBoundingClientRect().width);
                        tester.remove();
                        const relX = e.clientX - rect.left;
                        const relY = e.clientY - rect.top;
                        const col = Math.floor(relX / ch);
                        const row = Math.floor(relY / lineH);
                        const width = parseInt(preEl.dataset.sbWidth || '30', 10);
                        const iconCols = 3; // '[x]' or '[+]'
                        // Adjust for left border '║'
                        const contentCol = col - 1;
                        // title row is 1 (0 = top border), accept clicks in last 6 columns to be generous
                        const hitStart = Math.max(0, width - Math.max(6, iconCols));
                        const hitEndExclusive = width; // before right border
                        if (row === 1 && contentCol >= hitStart && contentCol < hitEndExclusive) {
                            this.toggleExpand(true);
                        }
                    });
                };
                // No longer needed; using positioned button overlay for reliability
            }

            toggleExpand(expand) {
                const modal = document.getElementById('shoutbox-float');
                const base = document.getElementById('shoutbox-container');
                if (!modal) return;
                this.isExpanded = !!expand;
                modal.style.display = this.isExpanded ? 'block' : 'none';
                if (base) base.style.display = this.isExpanded ? 'none' : '';
                // Make expanded view taller, especially on mobile
                this.maxLines = this.isExpanded
                  ? (window.innerWidth <= 600 ? 18 : 28)
                  : 5;
                this.renderMessages();
            }

            loadInitialMessages() {
                // Load initial messages via HTTP API
                fetch('/api/shoutbox/messages')
                    .then(response => response.json())
                    .then(messages => {
                        this.messages = messages.slice(-this.maxMessages);
                        this.renderMessages();
                    })
                    .catch(error => {
                        console.error('Failed to load initial messages:', error);
                    });
            }
        }

        // Initialize shoutbox when DOM is loaded
        document.addEventListener('DOMContentLoaded', function() {
            window.shoutbox = new ShoutboxManager();
        });

        // Handle show/hide more posts functionality
        document.addEventListener('DOMContentLoaded', function() {
            // Find all pre elements containing the show more boxes
            const allPreElements = document.querySelectorAll('pre');
            
            allPreElements.forEach(pre => {
                const text = pre.textContent;
                
                if (text.includes('▼ SHOW MORE POSTS ▼')) {
                    pre.style.cursor = 'pointer';
                    pre.addEventListener('click', function(e) {
                        const additionalPosts = document.getElementById('additional-posts-mobile');
                        if (additionalPosts) {
                            const isHidden = additionalPosts.style.display === 'none' || additionalPosts.style.display === '';
                            additionalPosts.style.display = isHidden ? 'block' : 'none';
                            
                            // Update button text without breaking ASCII structure
                            if (isHidden) {
                                pre.innerHTML = pre.innerHTML.replace('▼ SHOW MORE POSTS ▼', '▲ HIDE POSTS ▲');
                            } else {
                                pre.innerHTML = pre.innerHTML.replace('▲ HIDE POSTS ▲', '▼ SHOW MORE POSTS ▼');
                            }
                        }
                    });
                }
            });
        });
    </script>
</body>
</html> 

