<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ASCII Web</title>
    <style>
        @font-face {
            font-family: "Departure Mono";
            src: url("/static/fonts/DepartureMono-Regular.woff2") format("woff2"),
                 url("/static/fonts/DepartureMono-Regular.woff") format("woff"),
                 url("/static/fonts/DepartureMono-Regular.otf") format("opentype");
            font-weight: normal;
            font-style: normal;
            font-display: swap;
        }

        * {
            font-family: "Departure Mono", "Courier New", monospace;
            box-sizing: border-box;
        }

        /* Font stack optimized for emoji support per https://nolanlawson.com/2022/04/08/the-struggle-of-using-native-emoji-on-the-web/ */
        pre, .ascii-container {
            font-family: "Departure Mono",
                         "Twemoji Mozilla",
                         "Apple Color Emoji",
                         "Segoe UI Emoji",
                         "Segoe UI Symbol",
                         "Noto Color Emoji",
                         "EmojiOne Color",
                         "Android Emoji",
                         "Courier New",
                         monospace;
            text-rendering: optimizeLegibility;
        }

        html {
            height: 100%;
            margin: 0;
            padding: 0;
            background-color: #000000;
        }

        body {
            min-height: 100%;
            margin: 0;
            padding: 0;
            color: #fff;
            overflow-x: hidden;
            background: transparent;
            position: relative;
        }

        #stars-container {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 0;
            pointer-events: none;
            background-color: #000000;
        }

        .star {
            position: absolute;
            color: #fff;
            text-shadow: 0 0 8px rgba(255, 255, 255, 0.8),
                         0 0 12px rgba(255, 255, 255, 0.6),
                         0 0 16px rgba(255, 255, 255, 0.4);
            animation: twinkle 3s ease-in-out infinite;
            font-size: 20px;
            line-height: 1;
        }

        @keyframes twinkle {
            0%, 100% { 
                opacity: 0.2;
                transform: scale(1);
            }
            50% { 
                opacity: 1;
                transform: scale(1.2);
            }
        }

        .ascii-container {
            min-height: 100vh;
            padding: 10px;
            display: flex;
            flex-direction: column;
            gap: 10px;
            max-width: 1200px;
            margin: 0 auto;
            position: relative;
            z-index: 1;
            background: rgba(0, 0, 0, 0.7);
            backdrop-filter: blur(2px);
        }

        pre {
            white-space: pre;
            margin: 0;
            font-size: 14px;
            line-height: 1.2;
            overflow-x: auto;
            max-width: 100%;
            font-variant-ligatures: none;
            font-feature-settings: "kern" 0, "liga" 0, "calt" 0;
            letter-spacing: 0;
            word-spacing: 0;
            /* Ensure consistent character widths - critical for ASCII alignment */
            font-variant-numeric: tabular-nums;
            -webkit-font-smoothing: none;
            -moz-osx-font-smoothing: grayscale;
        }

        /* Ensure emoji and unicode characters render at predictable widths */
        pre::after {
            content: "";
            display: inline-block;
            width: 0;
        }

        .ascii-title {
            font-size: 0.8vw;
            white-space: pre;
            line-height: 1;
            margin: 0 auto;
            max-width: 100%;
        }

        .ascii-box {
            display: flex;
            flex-direction: column;
            min-height: fit-content;
        }

        .box-tiny, .box-small, .box-medium, .box-large {
            display: none;
        }

        @media (min-width: 901px) {
            .box-large { display: block; }
        }

        @media (min-width: 601px) and (max-width: 900px) {
            .box-medium { display: block; }
        }

        @media (min-width: 301px) and (max-width: 600px) {
            .box-small { display: block; }
        }

        @media (max-width: 300px) {
            .box-tiny { display: block; }
        }

        .main-content-wrapper {
            display: flex;
            gap: 10px;
        }

        .ascii-content {
            flex: 4;
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .ascii-sidebar {
            flex: 1;
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        @media (max-width: 600px) {
            .main-content-wrapper {
                flex-direction: column;
            }
            .ascii-sidebar {
                display: none;
            }
        }

        .ascii-nav a,
        .ascii-content a,
        .ascii-sidebar a {
            color: #33aaff;
            text-decoration: none;
        }

        .ascii-nav a:hover,
        .ascii-content a:hover,
        .ascii-sidebar a:hover {
            text-decoration: underline;
        }

        /* Emoji images - force to exactly 1 monospace character width */
        .emoji-img {
            display: inline-block;
            height: 1em;
            width: 1ch !important;
            min-width: 1ch;
            max-width: 1ch;
            vertical-align: baseline;
            object-fit: contain;
            margin: 0;
            padding: 0;
            border: 0;
        }
    </style>
</head>
<body>
    <div id="stars-container">
        {% for star in stars %}
            <div class="star" style="left: {{ star.x }}%; top: {{ star.y }}%; animation-delay: {{ star.delay }}s; transform: scale({{ star.size }});">{{ star.char }}</div>
        {% endfor %}
    </div>
    <div class="ascii-container">
        <div class="ascii-title">
            <pre>{{ title_art | safe }}</pre>
        </div>

        <div class="ascii-nav">
            <div class="box-tiny"><pre>{{ navigation_box.tiny | safe }}</pre></div>
            <div class="box-small"><pre>{{ navigation_box.small | safe }}</pre></div>
            <div class="box-medium"><pre>{{ navigation_box.medium | safe }}</pre></div>
            <div class="box-large"><pre>{{ navigation_box.large | safe }}</pre></div>
        </div>

        <div class="main-content-wrapper">
            <div class="ascii-content">
                <div class="ascii-box">
                    <div class="box-tiny"><pre>{{ welcome_box.tiny | safe }}</pre></div>
                    <div class="box-small"><pre>{{ welcome_box.small | safe }}</pre></div>
                    <div class="box-medium"><pre>{{ welcome_box.medium | safe }}</pre></div>
                    <div class="box-large"><pre>{{ welcome_box.large | safe }}</pre></div>
                </div>

                <div class="ascii-box">
                    <div class="box-tiny"><pre>{{ latest_post_box.tiny | safe }}</pre></div>
                    <div class="box-small"><pre>{{ latest_post_box.small | safe }}</pre></div>
                    <div class="box-medium"><pre>{{ latest_post_box.medium | safe }}</pre></div>
                    <div class="box-large"><pre>{{ latest_post_box.large | safe }}</pre></div>
                </div>
            </div>

            <div class="ascii-sidebar">
                <div class="ascii-box">
                    <div class="box-tiny"><pre>{{ about_box.tiny | safe }}</pre></div>
                    <div class="box-small"><pre>{{ about_box.small | safe }}</pre></div>
                    <div class="box-medium"><pre>{{ about_box.medium | safe }}</pre></div>
                    <div class="box-large"><pre>{{ about_box.large | safe }}</pre></div>
                </div>

                <div class="ascii-box">
                    <div class="box-tiny"><pre>{{ categories_box.tiny | safe }}</pre></div>
                    <div class="box-small"><pre>{{ categories_box.small | safe }}</pre></div>
                    <div class="box-medium"><pre>{{ categories_box.medium | safe }}</pre></div>
                    <div class="box-large"><pre>{{ categories_box.large | safe }}</pre></div>
                </div>

                <div class="ascii-box">
                    <div class="box-tiny"><pre>{{ comments_box.tiny | safe }}</pre></div>
                    <div class="box-small"><pre>{{ comments_box.small | safe }}</pre></div>
                    <div class="box-medium"><pre>{{ comments_box.medium | safe }}</pre></div>
                    <div class="box-large"><pre>{{ comments_box.large | safe }}</pre></div>
                </div>
            </div>
        </div>

        <div class="ascii-footer">
            <div class="box-tiny"><pre>{{ footer_box.tiny | safe }}</pre></div>
            <div class="box-small"><pre>{{ footer_box.small | safe }}</pre></div>
            <div class="box-medium"><pre>{{ footer_box.medium | safe }}</pre></div>
            <div class="box-large"><pre>{{ footer_box.large | safe }}</pre></div>
        </div>
    </div>

    <script type="module">
        // Load WASM module and initialize ASCII cat
        import init, { AsciiCat } from '/static/wasm/ascii_web.js';

            async function run() {
                try {
                    console.log('Starting ASCII cat initialization...');

                    // Initialize WASM
                    await init();
                    console.log('WASM initialized');
                
                    // Preload all cat animations
                    console.log('Preloading cat animations...');
                    const animations = {};
                    const animationNames = [
                        'still', 'alert', 'yawn', 'sleep1', 'sleep2',
                        'nrun1', 'nrun2', 'nerun1', 'nerun2',
                        'erun1', 'erun2', 'serun1', 'serun2',
                        'srun1', 'srun2', 'swrun1', 'swrun2',
                        'wrun1', 'wrun2', 'nwrun1', 'nwrun2',
                        'nscratch1', 'nscratch2', 'escratch1', 'escratch2',
                        'sscratch1', 'sscratch2', 'wscratch1', 'wscratch2',
                        'wash', 'itch1', 'itch2'
                    ];
                    
                    for (const name of animationNames) {
                        try {
                            console.log(`Fetching animation: /cat/${name}`);
                            const response = await fetch(`/cat/${name}`);
                            console.log(`Response status for ${name}:`, response.status);
                            
                            if (!response.ok) {
                                throw new Error(`HTTP ${response.status}: ${response.statusText}`);
                            }
                            
                            const content = await response.text();
                            animations[name] = content;
                            console.log(`Loaded animation: ${name} (${content.length} chars)`);
                        } catch (error) {
                            console.error(`Failed to load animation ${name}:`, error);
                        }
                    }
                    
                    console.log('All animations preloaded');
                    console.log('Animation keys:', Object.keys(animations));
                    console.log('Sample animation (still):', animations.still ? 'loaded' : 'missing');
                
                    // Create ASCII cat instance with animations
                    const cat = new AsciiCat(animations);
                    console.log('ASCII cat instance created');
                
                // Track mouse movement (oneko.js style)
                document.addEventListener('mousemove', (e) => {
                    cat.update_mouse(e.clientX, e.clientY);
                });
                console.log('Mouse listener added');
                
                // Animation loop (ultra smooth - 30ms intervals for very fluid motion ~33fps)
                let lastFrameTimestamp;
                function onAnimationFrame(timestamp) {
                    if (!lastFrameTimestamp) {
                        lastFrameTimestamp = timestamp;
                    }
                    if (timestamp - lastFrameTimestamp > 30) {  // 30ms = ~33fps for ultra smooth animation
                        lastFrameTimestamp = timestamp;
                        cat.update();
                    }
                    requestAnimationFrame(onAnimationFrame);
                }
                requestAnimationFrame(onAnimationFrame);
                console.log('Animation loop started (ultra smooth ~33fps)');
                
                console.log('ASCII cat is now following your cursor!');
            } catch (error) {
                console.error('Error initializing ASCII cat:', error);
            }
        }

        run();
    </script>
</body>
</html> 