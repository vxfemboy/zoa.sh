<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>vxfemboy</title>
    <link rel="icon" type="image/png" href="/static/favicon.png">
    <link rel="stylesheet" href="/static/css/main.css">
    <div id="stars-container">
        {% for star in stars %}
            <div class="star" style="left: {{ star.x }}%; top: {{ star.y }}%; animation-delay: {{ star.delay }}s; transform: scale({{ star.size }});">{{ star.char }}</div>
        {% endfor %}
    </div>
    <div class="ascii-container">
        <div class="ascii-title">
            <pre>{{ title_art | safe }}</pre>
        </div>

        <div class="ascii-nav">
            <div class="box-tiny"><pre>{{ navigation_box.tiny | safe }}</pre></div>
            <div class="box-small"><pre>{{ navigation_box.small | safe }}</pre></div>
            <div class="box-medium"><pre>{{ navigation_box.medium | safe }}</pre></div>
            <div class="box-large"><pre>{{ navigation_box.large | safe }}</pre></div>
        </div>

        <div class="main-content-wrapper">
            <div class="ascii-content">
                <div class="ascii-box welcome-box">
                    <div class="box-tiny"><pre>{{ welcome_box.tiny | safe }}</pre></div>
                    <div class="box-small"><pre>{{ welcome_box.small | safe }}</pre></div>
                    <div class="box-medium"><pre>{{ welcome_box.medium | safe }}</pre></div>
                    <div class="box-large"><pre>{{ welcome_box.large | safe }}</pre></div>
                </div>

                <div class="ascii-box latest-posts-box">
                    <div class="box-tiny"><pre>{{ latest_post_box.tiny | safe }}</pre></div>
                    <div class="box-small"><pre>{{ latest_post_box.small | safe }}</pre></div>
                    <div class="box-medium"><pre>{{ latest_post_box.medium | safe }}</pre></div>
                    <div class="box-large"><pre>{{ latest_post_box.large | safe }}</pre></div>
                </div>

                <!-- Additional posts for mobile dropdown -->
                <div id="additional-posts-mobile" style="display:none;">
                    {% for post in additional_posts %}
                    <div class="ascii-box">
                        <div class="box-small">
                            <pre>░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░

{{ post.title }}
{{ post.date }}

{{ post.content }}

Read more: <a href="{{ post.href }}">{{ post.title }}</a>

░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░</pre>
                        </div>
                    </div>
                    {% endfor %}
                </div>

            </div>

            <div class="ascii-sidebar">
                <div class="ascii-box" data-no-responsive>
                    <div class="box-tiny"><pre>{{ about_box.tiny | safe }}</pre></div>
                    <div class="box-small"><pre>{{ about_box.small | safe }}</pre></div>
                    <div class="box-medium"><pre>{{ about_box.medium | safe }}</pre></div>
                    <div class="box-large"><pre>{{ about_box.large | safe }}</pre></div>
                </div>

                <div class="ascii-box">
                    <div class="box-tiny"><pre>{{ categories_box.tiny | safe }}</pre></div>
                    <div class="box-small"><pre>{{ categories_box.small | safe }}</pre></div>
                    <div class="box-medium"><pre>{{ categories_box.medium | safe }}</pre></div>
                    <div class="box-large"><pre>{{ categories_box.large | safe }}</pre></div>
                </div>

                <div class="ascii-box" id="shoutbox-container" data-no-responsive>
                    <div class="box-large">
                        <pre id="shoutbox">{{ comments_box.large | safe }}</pre>
                        <div class="shoutbox-input-container">
                            <input type="text" id="shoutbox-input" placeholder="username: message" maxlength="120">
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="ascii-footer">
            <div class="box-tiny"><pre>{{ footer_box.tiny | safe }}</pre></div>
            <div class="box-small"><pre>{{ footer_box.small | safe }}</pre></div>
            <div class="box-medium"><pre>{{ footer_box.medium | safe }}</pre></div>
            <div class="box-large"><pre>{{ footer_box.large | safe }}</pre></div>
        </div>
    </div>

    <script type="module" src="/static/js/cat.js"></script>
    <script type="module" src="/static/js/shoutbox.js"></script>
    <script type="module" src="/static/js/show-more.js"></script>
    <script type="module" src="/static/js/responsive-pre.js"></script>

    <!-- Floating (draggable) Shoutbox -->
    <div id="shoutbox-float">
        <div class="shoutbox-float-content" style="position: relative;">
            <pre id="shoutbox-modal-pre"></pre>
            <div class="shoutbox-input-container">
                <input type="text" id="shoutbox-input-modal" placeholder="username: message" maxlength="120">
            </div>
            <!-- Click overlay for [x] icon inside expanded title bar -->
            <button id="sb-collapse-btn" class="sb-icon-hit" type="button" title="Collapse shoutbox" style="right: 6px; top: 18px; width: 40px; height: 18px; background: transparent; border: 0; padding: 0; z-index: 1;"></button>
        </div>
    </div>

</body>
</html> 

