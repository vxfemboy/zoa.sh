<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Blog - vxfemboy</title>
    <meta name="description" content="Blog posts from vxfemboy - tutorials, projects, and random thoughts">

    <!-- Open Graph -->
    <meta property="og:type" content="website">
    <meta property="og:url" content="{{ canonical }}">
    <meta property="og:title" content="Blog - vxfemboy">
    <meta property="og:description" content="Blog posts from vxfemboy - tutorials, projects, and random thoughts">
    <meta property="og:image" content="{{ og_image }}">

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="Blog - vxfemboy">
    <meta name="twitter:description" content="Blog posts from vxfemboy - tutorials, projects, and random thoughts">
    <meta name="twitter:image" content="{{ og_image }}">

    <link rel="canonical" href="{{ canonical }}">
    <link rel="icon" type="image/png" href="/static/favicon.png">
    <link rel="stylesheet" href="/static/css/main.css">
    <link rel="alternate" type="application/rss+xml" title="vxfemboy blog RSS" href="/rss.xml">
    <script>window.ZOA_DEBUG = {{ debug | json_encode }};</script>
</head>
<body>
    <h1 class="sr-only">Blog — vxfemboy</h1>
    <div id="stars-container">
        {% for star in stars %}
            <div class="star" style="left: {{ star.x }}%; top: {{ star.y }}%; animation-delay: {{ star.delay }}s; transform: scale({{ star.size }});">{{ star.char }}</div>
        {% endfor %}
    </div>
    <div class="ascii-container">
        <div class="ascii-title">
            <pre>{{ title_art | safe }}</pre>
        </div>

        <div class="ascii-nav">
            <div class="box-tiny"><pre>{{ navigation_box.tiny | safe }}</pre></div>
            <div class="box-small"><pre>{{ navigation_box.small | safe }}</pre></div>
            <div class="box-medium"><pre>{{ navigation_box.medium | safe }}</pre></div>
            <div class="box-large"><pre>{{ navigation_box.large | safe }}</pre></div>
        </div>

        <div class="main-content-wrapper">
            <div class="ascii-content blog-content">
                <div class="ascii-box">
                    <div class="box-tiny"><pre>{{ blog_header_box.tiny | safe }}</pre></div>
                    <div class="box-small"><pre>{{ blog_header_box.small | safe }}</pre></div>
                    <div class="box-medium"><pre>{{ blog_header_box.medium | safe }}</pre></div>
                    <div class="box-large"><pre>{{ blog_header_box.large | safe }}</pre></div>
                </div>

                <h2 class="sr-only">Latest posts</h2>
                {% for post in posts %}
                <div class="ascii-box blog-post-card" data-index="{{ loop.index0 }}">
                    <div class="box-tiny"><pre>{{ post.box_tiny | safe }}</pre></div>
                    <div class="box-small"><pre>{{ post.box_small | safe }}</pre></div>
                    <div class="box-medium"><pre>{{ post.box_medium | safe }}</pre></div>
                    <div class="box-large"><pre>{{ post.box_large | safe }}</pre></div>
                </div>
                {% endfor %}
                <div id="blog-empty-state" class="blog-empty-state" hidden>No posts match your search.</div>
            </div>

            <div class="ascii-sidebar">
                <div class="ascii-box search-widget">
                    <div class="ascii-frame" aria-hidden="true">
                        <span class="ascii-frame-h ascii-frame-top">╔<span class="ascii-frame-fill"></span>╗</span>
                        <span class="ascii-frame-v ascii-frame-left"></span>
                        <span class="ascii-frame-v ascii-frame-right"></span>
                        <span class="ascii-frame-h ascii-frame-bottom">╚<span class="ascii-frame-fill"></span>╝</span>
                    </div>
                    <div class="search-widget-inner">
                        <h2 class="search-widget-title">SEARCH</h2>
                        <div class="search-row">
                            <input type="text" id="blog-search-input" class="search-input" placeholder="Search posts..." autocomplete="off">
                            <button type="button" id="blog-filter-toggle" class="filter-toggle" aria-expanded="false" aria-controls="blog-tag-panel" title="Filter by tag">
                                <span aria-hidden="true">&#9776;</span>
                                <span id="blog-filter-count" class="filter-count" hidden>0</span>
                            </button>
                        </div>
                        <div id="blog-tag-panel" class="tag-panel" hidden>
                            <input type="text" id="blog-tag-search-input" class="tag-search-input" placeholder="Filter tags..." autocomplete="off">
                            <div id="blog-tag-pills" class="tag-pills"></div>
                            <div class="tag-panel-actions">
                                <button type="button" id="blog-tag-expand" class="tag-expand" hidden>+<span id="blog-tag-expand-count"></span> more</button>
                                <button type="button" id="blog-tag-clear" class="tag-clear">Clear tags</button>
                            </div>
                        </div>
                        <div id="blog-results-count" class="results-count"></div>
                    </div>
                </div>

                <div class="ascii-box">
                    <div class="box-tiny"><pre>{{ rss_box.tiny | safe }}</pre></div>
                    <div class="box-small"><pre>{{ rss_box.small | safe }}</pre></div>
                    <div class="box-medium"><pre>{{ rss_box.medium | safe }}</pre></div>
                    <div class="box-large"><pre>{{ rss_box.large | safe }}</pre></div>
                </div>
            </div>
        </div>

        <script type="application/json" id="blog-search-data">{{ search_index_json | safe }}</script>
        <script type="application/json" id="blog-all-tags">{{ all_tags_json | safe }}</script>

        <div class="ascii-footer">
            <div class="box-tiny"><pre>{{ footer_box.tiny | safe }}</pre></div>
            <div class="box-small"><pre>{{ footer_box.small | safe }}</pre></div>
            <div class="box-medium"><pre>{{ footer_box.medium | safe }}</pre></div>
            <div class="box-large"><pre>{{ footer_box.large | safe }}</pre></div>
        </div>
    </div>

    <script type="module" src="/static/js/cat.js"></script>
    <script type="module" src="/static/js/responsive-pre.js"></script>
    <script type="module" src="/static/js/blog-search.js"></script>
</body>
</html>
