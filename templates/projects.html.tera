<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Projects - vxfemboy</title>
    <meta name="description" content="Things vxfemboy (Zoa Hickenlooper) has built and broken — an ISP, this site, AI automation, security tooling.">

    <!-- Open Graph -->
    <meta property="og:type" content="website">
    <meta property="og:url" content="{{ canonical }}">
    <meta property="og:title" content="Projects - vxfemboy">
    <meta property="og:description" content="an ISP, this site, AI automation, breach-and-attack tooling">
    <meta property="og:image" content="{{ og_image }}">

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="Projects - vxfemboy">
    <meta name="twitter:description" content="an ISP, this site, AI automation, breach-and-attack tooling">
    <meta name="twitter:image" content="{{ og_image }}">

    <link rel="canonical" href="{{ canonical }}">
    <link rel="icon" type="image/png" href="/static/favicon.png">
    <link rel="stylesheet" href="/static/css/main.css">
    <link rel="alternate" type="application/rss+xml" title="vxfemboy blog RSS" href="/rss.xml">
</head>
<body>
    <script>window.ZOA_DEBUG = {{ debug | json_encode }};</script>
    <h1 class="sr-only">Projects — vxfemboy</h1>
    <div id="stars-container">
        {% for star in stars %}
            <div class="star" style="left: {{ star.x }}%; top: {{ star.y }}%; animation-delay: {{ star.delay }}s; transform: scale({{ star.size }});">{{ star.char }}</div>
        {% endfor %}
    </div>
    <div class="ascii-container">
        <div class="ascii-title">
            <pre>{{ title_art | safe }}</pre>
        </div>

        <div class="ascii-nav">
            <div class="box-tiny"><pre>{{ navigation_box.tiny | safe }}</pre></div>
            <div class="box-small"><pre>{{ navigation_box.small | safe }}</pre></div>
            <div class="box-medium"><pre>{{ navigation_box.medium | safe }}</pre></div>
            <div class="box-large"><pre>{{ navigation_box.large | safe }}</pre></div>
        </div>

        <div class="main-content-centered">
            <div class="ascii-content">
                <h2 class="sr-only">Projects</h2>
                {% for box in projects %}
                <div class="ascii-box">
                    <div class="box-tiny"><pre>{{ box.tiny | safe }}</pre></div>
                    <div class="box-small"><pre>{{ box.small | safe }}</pre></div>
                    <div class="box-medium"><pre>{{ box.medium | safe }}</pre></div>
                    <div class="box-large"><pre>{{ box.large | safe }}</pre></div>
                </div>
                {% endfor %}
            </div>
        </div>

        <div class="ascii-footer">
            <div class="box-tiny"><pre>{{ footer_box.tiny | safe }}</pre></div>
            <div class="box-small"><pre>{{ footer_box.small | safe }}</pre></div>
            <div class="box-medium"><pre>{{ footer_box.medium | safe }}</pre></div>
            <div class="box-large"><pre>{{ footer_box.large | safe }}</pre></div>
        </div>
    </div>

    <script type="module" src="/static/js/cat.js"></script>
    <script type="module" src="/static/js/responsive-pre.js"></script>
</body>
</html>
