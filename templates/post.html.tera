<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title }} - vxfemboy</title>
    <meta name="description" content="{{ title }} - A blog post by vxfemboy">

    <!-- Open Graph -->
    <meta property="og:type" content="article">
    <meta property="og:url" content="https://zoa.sh/post/{{ slug }}">
    <meta property="og:title" content="{{ title }}">
    <meta property="og:description" content="{{ title }} - A blog post by vxfemboy">
    <meta property="og:image" content="https://zoa.sh/static/og-image.gif">
    <meta property="article:published_time" content="{{ date }}">
    <meta property="article:author" content="vxfemboy">

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ title }}">
    <meta name="twitter:description" content="{{ title }} - A blog post by vxfemboy">
    <meta name="twitter:image" content="https://zoa.sh/static/og-image.gif">

    <link rel="icon" type="image/png" href="/static/favicon.png">
    <link rel="stylesheet" href="/static/css/main.css">
    <link rel="alternate" type="application/rss+xml" title="vxfemboy blog RSS" href="/rss.xml">
    <script>window.ZOA_DEBUG = {{ debug | json_encode }};</script>
</head>
<body>
    <div id="stars-container">
        {% for star in stars %}
            <div class="star" style="left: {{ star.x }}%; top: {{ star.y }}%; animation-delay: {{ star.delay }}s; transform: scale({{ star.size }});">{{ star.char }}</div>
        {% endfor %}
    </div>
    <div class="ascii-container">
        <div class="ascii-title">
            <pre>{{ title_art | safe }}</pre>
        </div>

        <div class="ascii-nav">
            <div class="box-tiny"><pre>{{ navigation_box.tiny | safe }}</pre></div>
            <div class="box-small"><pre>{{ navigation_box.small | safe }}</pre></div>
            <div class="box-medium"><pre>{{ navigation_box.medium | safe }}</pre></div>
            <div class="box-large"><pre>{{ navigation_box.large | safe }}</pre></div>
        </div>

        <div class="main-content-centered">
            <div class="ascii-content post-content">
                <div class="ascii-box post-header">
                    <div class="box-tiny"><pre>{{ post_header_box.tiny | safe }}</pre></div>
                    <div class="box-small"><pre>{{ post_header_box.small | safe }}</pre></div>
                    <div class="box-medium"><pre>{{ post_header_box.medium | safe }}</pre></div>
                    <div class="box-large"><pre>{{ post_header_box.large | safe }}</pre></div>
                </div>

                <div class="post-body">
                    <div class="ascii-frame" aria-hidden="true">
                        <span class="ascii-frame-h ascii-frame-top">╔<span class="ascii-frame-fill"></span>╗</span>
                        <span class="ascii-frame-v ascii-frame-left"></span>
                        <span class="ascii-frame-v ascii-frame-right"></span>
                        <span class="ascii-frame-h ascii-frame-bottom">╚<span class="ascii-frame-fill"></span>╝</span>
                    </div>
                    <div class="post-html-content">
                        {{ content_html | safe }}
                    </div>
                </div>
            </div>
        </div>

        <div class="ascii-footer">
            <div class="box-tiny"><pre>{{ footer_box.tiny | safe }}</pre></div>
            <div class="box-small"><pre>{{ footer_box.small | safe }}</pre></div>
            <div class="box-medium"><pre>{{ footer_box.medium | safe }}</pre></div>
            <div class="box-large"><pre>{{ footer_box.large | safe }}</pre></div>
        </div>
    </div>

    <script type="module" src="/static/js/cat.js"></script>
    <script type="module" src="/static/js/responsive-pre.js"></script>
    <script type="module" src="/static/js/scroll-container.js"></script>
</body>
</html>
